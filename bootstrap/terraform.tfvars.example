# Example variables for bootstrap infrastructure
# Copy this file to terraform.tfvars and customize the values

# S3 bucket name for Terraform state (must be globally unique)
state_bucket_name = "craftista-terraform-state-your-unique-suffix"

# DynamoDB table name for state locking
dynamodb_table_name = "terraform-state-locks"

# IAM policy name for Terraform state access
iam_policy_name = "TerraformStatePolicy"

# AWS region for bootstrap resources
aws_region = "us-east-1"

# Additional tags for all resources (comprehensive tagging strategy)
tags = {
  Project     = "craftista"
  Environment = "bootstrap"
  Owner       = "your-name"
  Department  = "devops"
  Backup      = "required"
  Monitoring  = "enabled"
}