# Development Environment - Example Terraform Variables
# Copy this file to terraform.tfvars and customize the values
# Note: terraform.tfvars is gitignored to prevent sensitive data from being committed

#######################################
# Project Configuration
#######################################
project_name = "craftista"
environment  = "dev"
aws_region   = "us-east-1"
owner_email  = "your-email@example.com"

#######################################
# Network Configuration
#######################################
vpc_cidr                = "10.1.0.0/16"
availability_zones      = ["us-east-1a", "us-east-1b"]
private_subnet_cidrs    = ["10.1.1.0/24", "10.1.2.0/24"]
public_subnet_cidrs     = ["10.1.101.0/24", "10.1.102.0/24"]
database_subnet_cidrs   = ["10.1.201.0/24", "10.1.202.0/24"]
enable_vpc_flow_logs    = true

#######################################
# EKS Configuration
#######################################
kubernetes_version = "1.30"

# Development uses minimal resources and SPOT instances for cost savings
node_groups = {
  general = {
    desired_size   = 2
    min_size       = 1
    max_size       = 4
    instance_types = ["t3.small"]
    capacity_type  = "SPOT" # Use SPOT instances to reduce costs in dev
  }
}

#######################################
# RDS PostgreSQL Configuration
#######################################
rds_allocated_storage       = 20
rds_engine_version          = "16.3"
rds_instance_class          = "db.t3.micro"
rds_username                = "craftista_admin"
rds_password                = "CHANGE_ME_SECURE_PASSWORD_HERE" # Use AWS Secrets Manager in production
rds_multi_az                = false                             # Single AZ for dev to reduce costs
rds_backup_retention_period = 7

#######################################
# ElastiCache Redis Configuration
#######################################
redis_engine_version            = "7.1"
redis_node_type                 = "cache.t3.micro"
redis_num_cache_nodes           = 1
redis_automatic_failover_enabled = false # Single node for dev

#######################################
# DocumentDB (MongoDB-compatible) Configuration
#######################################
docdb_engine_version         = "5.0.0"
docdb_instance_class         = "db.t3.medium"
docdb_num_instances          = 1      # Single instance for dev
docdb_master_username        = "craftista_admin"
docdb_master_password        = "CHANGE_ME_SECURE_PASSWORD_HERE" # Use AWS Secrets Manager in production
docdb_backup_retention_period = 7

#######################################
# DevOps Tools Configuration
# Note: SSH key pairs are no longer needed - SSM Session Manager is configured
#######################################
sonarqube_instance_type    = "t3.medium"
nexus_instance_type        = "t3.medium"
sonarqube_data_volume_size = 50
nexus_data_volume_size     = 100

#######################################
# Cost Management
#######################################
budget_amount = 5    # $5/month budget alert for dev environment
budget_email  = "your-email@example.com"

#######################################
# Common Tags
#######################################
tags = {
  Environment = "dev"
  Project     = "craftista"
  ManagedBy   = "terraform"
  Owner       = "your-name"
  CostCenter  = "engineering"
}
